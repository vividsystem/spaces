  "query": "\n        UPDATE spaces\n        SET\n            name = COALESCE($2, name),\n            description = COALESCE($3, description),\n            is_public = COALESCE($4, is_public),\n            access_code = COALESCE($5, access_code)\n        WHERE id = $1 AND (access_code = $5 OR access_code IS NULL)\n        RETURNING *;\n        ",
